{
  "name": "database",
  "version": "1.0.0",
  "description": "database for solomon",
  "license": "ISC",
  "author": "Charlie Miller",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx seed.ts",
